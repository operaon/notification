# ==================== SERVICE ====================
NODE_ENV=development
SERVICE_NAME=operaon_notification
HOST=0.0.0.0
PORT=4720
NOTIFICATION_PORT=4720
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=operaon_notification
DB_USER=dbadmin
DB_PASSWORD=change-me
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Optional full connection string. When set, it takes precedence over DB_*.
# DATABASE_URL=postgres://dbadmin:change-me@localhost:5432/operaon_notification

# ==================== BACKEND AUTH ====================
SERVICE_API_KEY=notification-development-service-key
NOTIFICATION_SERVICE_API_KEY=notification-development-service-key
JWT_ALGORITHM=HS256
JWT_SECRET=notification-development-jwt-secret-change-me
JWT_ISSUER=operaon-identity
JWT_AUDIENCE=operaon-api,operaon-notification
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==================== DELIVERY ====================
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_INTERVAL_MS=1000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_LEASE_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_DELIVERY_TIMEOUT_MS=10000
NOTIFICATION_DEFAULT_EXPIRATION_DAYS=30
NOTIFICATION_IN_APP_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false

# ==================== WEB PUSH / VAPID ====================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@operaon.local

# ==================== SMTP ====================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@operaon.local
EMAIL_FROM_NAME=Operaon

# ==================== OPERATIONAL ====================
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LIMIT=300

# ==================== OPERAON COMMUNICATION CONTRACT ====================
# Identidade não secreta do serviço. Segredos reais devem vir do secret manager.
SERVICE_NAME=operaon-notification
COMMUNICATION_PROTOCOL_VERSION=1
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
INTERNAL_REQUEST_TIMEOUT_MS=5000
INTERNAL_RETRY_MAX_ATTEMPTS=3
COMMUNICATION_KEY_ID=service-key-v1
WEBHOOK_KEY_ID=webhook-key-v1
